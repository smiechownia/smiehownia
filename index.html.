<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Śmiehownia — miejsce na krótką przerwę i dobry humor.">
<title>Śmiehownia — dawka dobrego humoru</title>
<style>
:root{color-scheme:dark;--bg:#10111b;--panel:#1b1d2c;--muted:#aaaec2;--accent:#b69cff;--pink:#f2b4ef;--line:#34364c}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at top,#292044,#10111b 48%);color:#f8f5ff;font:16px/1.55 system-ui,Segoe UI,sans-serif}
header{text-align:center;padding:42px 18px 24px}h1{font-size:clamp(2.4rem,7vw,4.4rem);line-height:1.1;margin:0;color:#eadcff}header p{color:var(--muted);margin:10px 0}
main{max-width:1050px;margin:auto;padding:0 16px 50px}.panel{background:#1b1d2cf2;border:1px solid var(--line);border-radius:18px;padding:20px;margin:16px 0;box-shadow:0 12px 35px #0003}
.ad{max-width:970px;min-height:92px;margin:18px auto;border:1px dashed #77718f;border-radius:14px;background:#171827;color:#aaa4bd;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:12px}
.ad b{font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:#d9c9fa}.ad span{font-size:.88rem}
.controls{display:flex;gap:8px;flex-wrap:wrap}button,input,select{font:inherit;border-radius:10px;padding:10px 12px}button{border:0;background:linear-gradient(100deg,var(--accent),var(--pink));color:#21152d;font-weight:700;cursor:pointer}button.secondary{background:#34364c;color:white}input,select{background:#11121e;color:white;border:1px solid #454760}
#jokes{display:grid;grid-template-columns:repeat(auto-fit,minmax(245px,1fr));gap:12px}.joke{background:#24263a;border:1px solid var(--line);border-radius:14px;padding:15px}.joke p{margin:8px 0 12px}.tag{font-size:.78rem;color:#d7c7ff}.stars{color:#f6d78b}.muted{color:var(--muted);font-size:.9rem}
footer{text-align:center;padding:20px;color:var(--muted)}a{color:#d8c6ff}
</style>
</head>
<body>
<header><h1>Śmiehownia 😂</h1><p>Mała przerwa na wielki uśmiech.</p></header>
<main>
<!-- MIEJSCE REKLAMOWE 1: po akceptacji AdSense wklej tutaj kod jednostki reklamowej. -->
<div class="ad" aria-label="Miejsce reklamowe"><b>Reklama</b><span>Miejsce na reklamę — reklamy nie są jeszcze aktywne.</span></div>
<section class="panel">
<h2>Znajdź coś do pośmiania</h2>
<div class="controls">
<input id="search" type="search" placeholder="Szukaj żartu…" aria-label="Szukaj żartu">
<select id="category" aria-label="Wybierz kategorię"><option value="">Wszystkie kategorie</option><option>Szkoła</option><option>Praca</option><option>Zwierzęta</option><option>Technologia</option><option>Suche żarty</option></select>
<button id="random">Losuj żart 🎲</button>
</div>
</section>
<section class="panel"><h2>😂 Żarty</h2><div id="jokes"></div></section>
<!-- MIEJSCE REKLAMOWE 2: można umieścić między sekcjami; nie dodawaj reklam zachęcających do kliknięcia. -->
<div class="ad" aria-label="Miejsce reklamowe"><b>Reklama</b><span>Miejsce na reklamę — reklamy nie są jeszcze aktywne.</span></div>
<section class="panel"><h2>Dodaj swój żart</h2>
<p class="muted">Na razie zgłoszenia działają tylko demonstracyjnie w tej przeglądarce. Publiczne dodawanie wymaga podłączenia bazy danych i moderacji.</p>
<input id="newCategory" placeholder="Kategoria" maxlength="40">
<p><input id="newJoke" placeholder="Treść żartu" maxlength="500" style="width:min(100%,650px)"></p>
<button id="add">Dodaj lokalnie</button><p id="notice" class="muted" aria-live="polite"></p>
</section>
<section class="panel"><h2>Informacje</h2>
<p class="muted">Śmiehownia jest projektem demonstracyjnym. Miejsca reklamowe są wyłącznie placeholderami — nie wyświetlają reklam, nie śledzą użytkowników i nie generują przychodu.</p>
<p><a href="polityka-prywatnosci.html">Polityka prywatności (do uzupełnienia przed publikacją)</a></p>
</section>
</main>
<footer>Śmiehownia © 2026</footer>
<script>
const jokes=[
["Szkoła","Dlaczego komputerowi jest zimno? Bo zostawił otwarte Windows."],
["Praca","Szef pyta: „Dlaczego jesteś spóźniony?” — „Bo znak mówił: szkoła, zwolnij!”"],
["Zwierzęta","Co mówi pies, gdy siada przy komputerze? Hau-ware."],
["Technologia","Dlaczego telefon poszedł do okulisty? Bo stracił kontakty."],
["Suche żarty","Co robi matematyk w ogrodzie? Liczy grządki."],
["Szkoła","Nauczyciel: „Jasiu, wymień dwa zaimki”. Jasiu: „Kto? Ja?”"],
["Zwierzęta","Jak nazywa się kot, który lubi czytać? Mruczek-pedia."]
];
const el=id=>document.getElementById(id);
function render(){const q=el("search").value.toLowerCase(),c=el("category").value;const filtered=jokes.filter(j=>(!c||j[0]===c)&&(!q||j.join(" ").toLowerCase().includes(q)));const root=el("jokes");root.replaceChildren();filtered.forEach(j=>{const card=document.createElement("article");card.className="joke";const tag=document.createElement("div");tag.className="tag";tag.textContent=j[0];const p=document.createElement("p");p.textContent=j[1];const stars=document.createElement("div");stars.className="stars";stars.textContent="★★★★★";card.append(tag,p,stars);root.append(card)});if(!filtered.length)root.textContent="Nie znaleziono żartów."}
el("search").addEventListener("input",render);el("category").addEventListener("change",render);
el("random").onclick=()=>{const j=jokes[Math.floor(Math.random()*jokes.length)];el("search").value="";el("category").value=j[0];render();el("notice").textContent="Wylosowano żart z kategorii: "+j[0]};
el("add").onclick=()=>{const body=el("newJoke").value.trim(),cat=el("newCategory").value.trim()||"Suche żarty";if(!body){el("notice").textContent="Najpierw wpisz treść żartu.";return}jokes.unshift([cat,body]);el("newJoke").value="";el("notice").textContent="Dodano żart lokalnie — widzisz go tylko w tej przeglądarce.";render()};
render();
</script>
</body>
</html>
